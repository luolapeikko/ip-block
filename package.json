{
	"$schema": "https://json.schemastore.org/package",
	"name": "@avanio/ip-block",
	"version": "0.0.3",
	"description": "Util to block IP",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown src/index.ts --minify --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"test": "vitest test --run --no-isolate --coverage",
		"lint": "biome check",
		"validate": "tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"repository": "github:luolapeikko/ip-block",
	"keywords": [
		"ip",
		"block"
	],
	"author": "mharj",
	"license": "LGPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/AvanioOy/ip-block/issues"
	},
	"homepage": "https://github.com/AvanioOy/ip-block#readme",
	"devDependencies": {
		"@avanio/expire-cache": "^0.7.0",
		"@avanio/logger-like": "^0.2.13",
		"@biomejs/biome": "^2.5.14",
		"@luolapeikko/cache-types": "^0.0.10",
		"@luolapeikko/result-option": "^2.4.0",
		"@luolapeikko/ts-common": "^1.1.6",
		"@types/node": "^22.20.3",
		"@vitest/coverage-v8": "^5.0.1",
		"c8": "^12.0.0",
		"ip-address": "^10.7.2",
		"prettier": "^3.9.8",
		"tsdown": "^0.23.0",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"@avanio/logger-like": ">= 0.2.10",
		"@luolapeikko/cache-types": ">= 0.0.8",
		"@luolapeikko/result-option": ">= 1.0.0",
		"@luolapeikko/ts-common": ">= 0.2.0",
		"ip-address": "^10.x"
	},
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
